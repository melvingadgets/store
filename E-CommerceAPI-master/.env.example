PORT=2222
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce
MONGODB_URI_FALLBACK=mongodb://127.0.0.1:27017/ecommerce
JWT_SECRET=replace_me
JWT_EXPIRES_IN=40m
APP_BASE_URL=http://localhost:2222
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace_me
SMTP_PASS=replace_me
MAIL_FROM="Mel Store <noreply@example.com>"
CLOUDINARY_CLOUD_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
FLW_PUBLIC_KEY=replace_me
FLW_SECRET_KEY=replace_me
FLW_ENCRYPTION_KEY=replace_me
AI_PROVIDER=openai
AI_API_KEY=replace_me
AI_MODEL=gpt-5-mini
AI_BASE_URL=

# Service-to-service calls (Shortwork/AGENTS.md §2). Until all four are set, EasyBuy's public
# catalog is used as before.
AUTH_ISSUER=
SERVICE_CLIENT_ID=
SERVICE_CLIENT_SECRET=
# EasyBuy's base URL; on Railway its private address, e.g. http://easybuy-api.railway.internal:8080
EASYBUY_API_URL=
# Read token for the private @melvingadgets/platform-kit package (GitHub, read:packages only).
NPM_TOKEN=

# Consume events from the relay (Shortwork/AGENTS.md §3.4). RELAY_JWKS_URL verifies delivery
# signatures; AUTH_JWKS_URL (defaults from AUTH_ISSUER) verifies the relay's service token.
# With all of AUTH_ISSUER, AUTH_JWKS_URL and RELAY_JWKS_URL set, the store mounts /internal/events.
AUTH_JWKS_URL=
RELAY_JWKS_URL=
